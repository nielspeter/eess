node_modules/
**/dist/
**/coverage/
*.tsbuildinfo
.DS_Store
.idea/
docs/.vitepress/dist/
docs/.vitepress/cache/
/.serena/
.playwright-mcp/
# .claude/ is tracked so repo-specific skills (e.g. /release) ship with the repo.
# Keep personal/local state out of git:
.claude/settings.local.json
.claude/**/*.local.*

# doc code-fence check scratch (plan 0082)
.docs-code-check/

# Local research/positioning drafts — not part of the engineering corpus, so no
# gate covers them (check:corpus roots are work/, adr/, docs/).
reports/

# scripts/check-nonvacuity.mjs's ephemeral probes (written just before a gate
# runs, deleted in a finally block) — a hard kill (SIGKILL, cancelled CI job)
# skips the finally, and since bug 0127 some probes live in tracked corpus
# roots (docs/, work/bugs/) instead of only packages/*/src.
**/__nonvacuity_probe*

# Bug 0045: runtime probe files written by
# packages/ts/tests/core/warn-survives-the-test-runner.test.ts. A crashed run
# leaves untracked .test.ts files that the next typecheck compiles.
packages/*/tests/__generated__/

# plan 0218: the new-proposal fixture plants an untracked proposal the rule must
# SEE, so it cannot use the `__nonvacuity_probe*` prefix the rule filters out.
work/proposals/999-nonvacuity-*
